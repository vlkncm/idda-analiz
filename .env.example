# https://dashboard.api-football.com adresinden ücretsiz anahtar alın.
API_FOOTBALL_KEY=
# İsteğe bağlı: API kullanımını özellikle kapatmak için false yapın.
USE_API_FOOTBALL=true
PORT=4173
CACHE_MINUTES=360

# Yeni production tahmin motoru (gerçek anahtarı .env dosyanıza yazın)
SPORTMONKS_API_KEY=
FOOTBALL_DATA_API_KEY=
DATABASE_URL=postgresql+psycopg://idda:change-me@postgres:5432/idda_analysis
POSTGRES_USER=idda
POSTGRES_PASSWORD=change-me
POSTGRES_DB=idda_analysis
SCHEDULER_ENABLED=false

