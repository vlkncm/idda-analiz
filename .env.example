PORT=4173
CACHE_MINUTES=360

# Yeni production tahmin motoru (gerçek anahtarı .env dosyanıza yazın)
SPORTMONKS_API_KEY=
FOOTBALL_DATA_API_KEY=
ODDS_API_KEY=
# Virgülle ayrılmış The Odds API bölgeleri (dinamik bookmaker listesi)
ODDS_API_REGIONS=eu,uk
ODDS_CACHE_MINUTES=10
ODDS_NEAR_KICKOFF_CACHE_MINUTES=3
DATABASE_URL=postgresql+psycopg://idda:change-me@postgres:5432/idda_analysis
POSTGRES_USER=idda
POSTGRES_PASSWORD=change-me
POSTGRES_DB=idda_analysis
SCHEDULER_ENABLED=false

# Gerçek fikstür sağlayıcıları (anahtarları yalnız kendi .env dosyanıza yazın)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
FIXTURE_PROVIDER=auto
FIXTURE_LOOKAHEAD_DAYS=14
FIXTURE_CACHE_MINUTES=360
FIXTURE_TIMEZONE=Europe/Istanbul
FIXTURE_REFRESH_COOLDOWN_SECONDS=60
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
THESPORTSDB_API_KEY=123

